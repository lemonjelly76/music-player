# Copy to .env and fill in. .env is git-ignored; this template is committed.

# PostgreSQL: any local password
POSTGRES_PASSWORD=

# The household login for the Android app and Claude Desktop (ADR-011)
APP_USERNAME=
APP_PASSWORD=

# Optional (ADR-011): lets a claude.ai custom connector call /mcp with "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
MCP_TOKEN=

# Where the streaming services send people back after they sign in (ADR-008), without a trailing slash,
# e.g. https://<pc>.<tailnet>.ts.net:8443. Register <PUBLIC_URL>/api/connect/tidal/callback with Tidal and
# <PUBLIC_URL>/api/connect/spotify/callback with Spotify.
PUBLIC_URL=

# Tidal (ADR-006): an app from developer.tidal.com. Leave empty to leave Tidal out.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
TIDAL_COUNTRY_CODE=GB

# Spotify (ADR-006): an app from developer.spotify.com in Development Mode. Leave empty to leave Spotify out.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=GB

# Last.fm (ADR-009): an API account from last.fm/api. Leave empty to leave Last.fm out.
LASTFM_API_KEY=

# MusicBrainz asks for a contact in the User-Agent: an email address or URL
MUSICBRAINZ_CONTACT=

# Optional Lidarr (ADR-012): Settings > General > API Key
LIDARR_URL=
LIDARR_API_KEY=
LIDARR_ROOT_FOLDER=/music
LIDARR_QUALITY_PROFILE_ID=1
LIDARR_METADATA_PROFILE_ID=1
